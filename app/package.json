{
  "name": "razkyn-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RAZKYN client: Vite + React + Phaser (CLAUDE.md §8).",
  "scripts": {
    "sync-idl": "node -e \"const f=require('fs');f.copyFileSync('../idl/razkyn.json','src/lib/razkyn.json');f.copyFileSync('../config/devnet.json','src/lib/devnet.json');f.copyFileSync('../data/mystery/merkle.json','src/lib/merkle.json')\"",
    "dev": "npm run sync-idl && vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.18.0",
    "@solana/spl-token": "0.4.14",
    "@solana/wallet-adapter-base": "0.9.28",
    "@solana/wallet-adapter-react": "0.15.40",
    "@solana/wallet-adapter-react-ui": "0.9.40",
    "@solana/web3.js": "1.99.0",
    "@types/three": "0.170.0",
    "buffer": "6.0.3",
    "phaser": "3.90.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.9.3",
    "vite": "6.3.5"
  },
  "overrides": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=22"
  }
